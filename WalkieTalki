
name: Build WalkieTalkiePro APK

on:
  workflow_dispatch:
  push:
    paths:
      - ".github/workflows/build-apk.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Create Android project
        shell: bash
        run: |
          mkdir -p app/src/main/java/com/walkietalkiepro
          mkdir -p app/src/main/res/values
          mkdir -p server

          cat > settings.gradle <<'EOF'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = "WalkieTalkiePro"
          include(":app")
          EOF

          cat > build.gradle <<'EOF'
          plugins {
              id 'com.android.application' version '8.7.3' apply false
              id 'org.jetbrains.kotlin.android' version '2.0.21' apply false
          }
          EOF

          cat > gradle.properties <<'EOF'
          org.gradle.jvmargs=-Xmx3g -XX:MaxMetaspaceSize=1g
          android.useAndroidX=true
          kotlin.code.style=official
          EOF

          cat > app/build.gradle <<'EOF'
          plugins {
              id 'com.android.application'
              id 'org.jetbrains.kotlin.android'
          }

          android {
              namespace 'com.walkietalkiepro'
              compileSdk 35

              defaultConfig {
                  applicationId 'com.walkietalkiepro'
                  minSdk 26
                  targetSdk 35
                  versionCode 1
                  versionName '1.0'
              }

              compileOptions {
                  sourceCompatibility JavaVersion.VERSION_17
                  targetCompatibility JavaVersion.VERSION_17
              }

              kotlinOptions {
                  jvmTarget = '17'
              }
          }

          dependencies {
              implementation 'org.java-websocket:Java-WebSocket:1.5.7'
          }
          EOF

          cat > app/src/main/res/values/styles.xml <<'EOF'
          <resources>
              <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
                  <item name="android:fontFamily">sans</item>
                  <item name="android:colorAccent">#16A085</item>
                  <item name="android:statusBarColor">#102A43</item>
                  <item name="android:navigationBarColor">#102A43</item>
                  <item name="android:windowLightStatusBar">false</item>
                  <item name="android:windowActionModeOverlay">true</item>
              </style>
          </resources>
          EOF

          cat > app/src/main/AndroidManifest.xml <<'EOF'
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
              <uses-permission android:name="android.permission.INTERNET"/>
              <uses-permission android:name="android.permission.RECORD_AUDIO"/>
              <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
              <uses-permission android:name="android.permission.BLUETOOTH"/>
              <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
              <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
              <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
              <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>

              <application
                  android:allowBackup="true"
                  android:label="اللاسلكي الذكي"
                  android:theme="@style/AppTheme"
                  android:usesCleartextTraffic="true">
                  <activity
                      android:name=".MainActivity"
                      android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN"/>
                          <category android:name="android.intent.category.LAUNCHER"/>
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF

          cat > app/src/main/java/com/walkietalkiepro/MainActivity.kt <<'EOF'
          package com.walkietalkiepro

          import android.Manifest
          import android.app.Activity
          import android.os.Bundle
          import android.os.Build
          import android.content.pm.PackageManager
          import android.graphics.Color
          import android.view.Gravity
          import android.view.MotionEvent
          import android.widget.*
          import android.bluetooth.BluetoothAdapter
          import android.bluetooth.BluetoothDevice
          import android.media.AudioFormat
          import android.media.AudioRecord
          import android.media.AudioTrack
          import android.media.MediaRecorder
          import android.media.AudioManager
          import android.media.AudioAttributes
          import android.media.AudioTrack.MODE_STREAM
          import android.media.AudioRecord.READ_BLOCKING
          import androidx.core.app.ActivityCompat
          import org.java_websocket.client.WebSocketClient
          import org.java_websocket.handshake.ServerHandshake
          import java.net.URI
          import java.util.UUID
          import java.io.InputStream
          import java.io.OutputStream
          import java.util.concurrent.atomic.AtomicBoolean
          import kotlin.concurrent.thread

          class MainActivity : Activity() {

              private val bg = Color.rgb(16, 42, 67)
              private val green = Color.rgb(22, 160, 133)
              private var mode = "internet"
              private var socket: WebSocketClient? = null
              private var bluetoothOut: OutputStream? = null
              private var bluetoothIn: InputStream? = null
              private var recorder: AudioRecord? = null
              private var player: AudioTrack? = null
              private val transmitting = AtomicBoolean(false)
              private var connected = false
              private lateinit var status: TextView
              private lateinit var address: EditText
              private lateinit var room: EditText
              private lateinit var connectButton: Button
              private lateinit var talkButton: Button

              private val sampleRate = 16000
              private val audioFormat =
                  AudioFormat.ENCODING_PCM_16BIT
              private val channelIn =
                  AudioFormat.CHANNEL_IN_MONO
              private val channelOut =
                  AudioFormat.CHANNEL_OUT_MONO

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  requestNeededPermissions()
                  buildInterface()
              }

              private fun requestNeededPermissions() {
                  val permissions = mutableListOf(
                      Manifest.permission.RECORD_AUDIO
                  )
                  if (Build.VERSION.SDK_INT >= 31) {
                      permissions.add(Manifest.permission.BLUETOOTH_CONNECT)
                      permissions.add(Manifest.permission.BLUETOOTH_SCAN)
                  }
                  val missing = permissions.filter {
                      ActivityCompat.checkSelfPermission(this, it) !=
                          PackageManager.PERMISSION_GRANTED
                  }
                  if (missing.isNotEmpty()) {
                      ActivityCompat.requestPermissions(
                          this, missing.toTypedArray(), 100
                      )
                  }
              }

              private fun buildInterface() {
                  val root = LinearLayout(this)
                  root.orientation = LinearLayout.VERTICAL
                  root.setPadding(24, 28, 24, 24)
                  root.setBackgroundColor(bg)
                  root.gravity = Gravity.CENTER_HORIZONTAL

                  val title = TextView(this)
                  title.text = "اللاسلكي الذكي"
                  title.textSize = 28f
                  title.setTextColor(Color.WHITE)
                  title.gravity = Gravity.CENTER
                  root.addView(title, full(70))

                  val subtitle = TextView(this)
                  subtitle.text = "WalkieTalkiePro"
                  subtitle.textSize = 15f
                  subtitle.setTextColor(Color.LTGRAY)
                  subtitle.gravity = Gravity.CENTER
                  root.addView(subtitle, full(35))

                  val modeRow = LinearLayout(this)
                  modeRow.orientation = LinearLayout.HORIZONTAL

                  val internet = Button(this)
                  internet.text = "وضع الإنترنت"
                  internet.setOnClickListener {
                      stopConnection()
                      mode = "internet"
                      status.text = "وضع الإنترنت: أدخل عنوان الخادم"
                  }

                  val bluetooth = Button(this)
                  bluetooth.text = "وضع البلوتوث"
                  bluetooth.setOnClickListener {
                      stopConnection()
                      mode = "bluetooth"
                      status.text = "وضع البلوتوث: أدخل عنوان الجهاز المقترن"
                  }

                  modeRow.addView(internet, LinearLayout.LayoutParams(0, 55, 1f))
                  modeRow.addView(bluetooth, LinearLayout.LayoutParams(0, 55, 1f))
                  root.addView(modeRow, full(65))

                  address = EditText(this)
                  address.setSingleLine(true)
                  address.setTextColor(Color.WHITE)
                  address.setHintTextColor(Color.LTGRAY)
                  address.hint = "رابط الخادم wss:// أو عنوان البلوتوث"
                  root.addView(address, full(60))

                  room = EditText(this)
                  room.setSingleLine(true)
                  room.setTextColor(Color.WHITE)
                  room.setHintTextColor(Color.LTGRAY)
                  room.hint = "اسم الغرفة المشتركة"
                  root.addView(room, full(60))

                  connectButton = Button(this)
                  connectButton.text = "اتصال"
                  connectButton.setOnClickListener {
                      if (connected) {
                          stopConnection()
                      } else {
                          if (mode == "internet") connectInternet()
                          else connectBluetooth()
                      }
                  }
                  root.addView(connectButton, full(60))

                  status = TextView(this)
                  status.text = "غير متصل"
                  status.textSize = 17f
                  status.setTextColor(Color.WHITE)
                  status.gravity = Gravity.CENTER
                  root.addView(status, full(65))

                  talkButton = Button(this)
                  talkButton.text = "اضغط باستمرار للتحدث"
                  talkButton.textSize = 19f
                  talkButton.setTextColor(Color.WHITE)
                  talkButton.setBackgroundColor(green)
                  talkButton.isEnabled = false
                  talkButton.setOnTouchListener { _, event ->
                      when (event.action) {
                          MotionEvent.ACTION_DOWN -> {
                              if (connected) startTalking()
                              true
                          }
                          MotionEvent.ACTION_UP,
                          MotionEvent.ACTION_CANCEL -> {
                              stopTalking()
                              true
                          }
                          else -> true
                      }
                  }
                  root.addView(talkButton, full(120))

                  val note = TextView(this)
                  note.text =
                      "اختر طريقة الاتصال. يجب أن يكون الجهازان على الغرفة نفسها في وضع الإنترنت."
                  note.setTextColor(Color.LTGRAY)
                  note.textSize = 13f
                  note.gravity = Gravity.CENTER
                  root.addView(note, full(90))

                  setContentView(root)
              }

              private fun full(height: Int): LinearLayout.LayoutParams {
                  return LinearLayout.LayoutParams(
                      LinearLayout.LayoutParams.MATCH_PARENT, height
                  ).apply {
                      topMargin = 7
                      bottomMargin = 7
                  }
              }

              private fun connectInternet() {
                  val url = address.text.toString().trim()
                  val roomName = room.text.toString().trim()
                  if (!url.startsWith("ws://") && !url.startsWith("wss://")) {
                      status.text = "أدخل رابط WebSocket صحيحاً"
                      return
                  }
                  if (roomName.isBlank()) {
                      status.text = "أدخل اسم الغرفة"
                      return
                  }
                  status.text = "جارٍ الاتصال..."
                  thread {
                      try {
                          val uri = URI(
                              url + if (url.contains("?")) "&room=" else "?room=" +
                                  java.net.URLEncoder.encode(roomName, "UTF-8")
                          )
                          val client = object : WebSocketClient(uri) {
                              override fun onOpen(handshake: ServerHandshake?) {
                                  runOnUiThread {
                                      connected = true
                                      talkButton.isEnabled = true
                                      connectButton.text = "قطع الاتصال"
                                      status.text = "متصل بالإنترنت"
                                  }
                              }
                              override fun onMessage(message: String?) {}
                              override fun onMessage(bytes: ByteArray?) {
                                  if (bytes != null) playAudio(bytes)
                              }
                              override fun onClose(code: Int, reason: String?, remote: Boolean) {
                                  runOnUiThread { setDisconnected("انقطع الاتصال") }
                              }
                              override fun onError(ex: Exception?) {
                                  runOnUiThread {
                                      status.text = "خطأ اتصال: ${ex?.message ?: "غير معروف"}"
                                  }
                              }
                          }
                          socket = client
                          client.connect()
                      } catch (e: Exception) {
                          runOnUiThread {
                              status.text = "تعذر الاتصال: ${e.message}"
                          }
                      }
                  }
              }

              private fun connectBluetooth() {
                  if (Build.VERSION.SDK_INT >= 31 &&
                      ActivityCompat.checkSelfPermission(
                          this, Manifest.permission.BLUETOOTH_CONNECT
                      ) != PackageManager.PERMISSION_GRANTED) {
                      status.text = "اسمح بصلاحية البلوتوث أولاً"
                      requestNeededPermissions()
                      return
                  }
                  val mac = address.text.toString().trim()
                  if (mac.isBlank()) {
                      status.text = "أدخل عنوان MAC للجهاز المقترن"
                      return
                  }
                  thread {
                      try {
                          val adapter = BluetoothAdapter.getDefaultAdapter()
                              ?: throw Exception("البلوتوث غير مدعوم")
                          val device: BluetoothDevice = adapter.getRemoteDevice(mac)
                          val uuid = UUID.fromString(
                              "00001101-0000-1000-8000-00805F9B34FB"
                          )
                          val btSocket = device.createRfcommSocketToServiceRecord(uuid)
                          adapter.cancelDiscovery()
                          btSocket.connect()
                          bluetoothOut = btSocket.outputStream
                          bluetoothIn = btSocket.inputStream
                          connected = true
                          runOnUiThread {
                              talkButton.isEnabled = true
                              connectButton.text = "قطع الاتصال"
                              status.text = "متصل بالبلوتوث"
                          }
                          thread {
                              val buffer = ByteArray(2048)
                              try {
                                  while (connected) {
                                      val count = bluetoothIn?.read(buffer) ?: -1
                                      if (count <= 0) break
                                      playAudio(buffer.copyOf(count))
                                  }
                              } catch (_: Exception) {}
                          }
                      } catch (e: Exception) {
                          runOnUiThread {
                              status.text = "فشل اتصال البلوتوث: ${e.message}"
                          }
                      }
                  }
              }

              private fun startTalking() {
                  if (!connected || !transmitting.compareAndSet(false, true)) return
                  thread {
                      try {
                          val min = AudioRecord.getMinBufferSize(
                              sampleRate, channelIn, audioFormat
                          )
                          val rec = AudioRecord(
                              MediaRecorder.AudioSource.VOICE_COMMUNICATION,
                              sampleRate, channelIn, audioFormat,
                              maxOf(min, 4096)
                          )
                          recorder = rec
                          rec.startRecording()
                          val buffer = ByteArray(2048)
                          while (transmitting.get() && connected) {
                              val count = rec.read(buffer, 0, buffer.size, READ_BLOCKING)
                              if (count > 0) {
                                  val data = buffer.copyOf(count)
                                  try {
                                      if (mode == "internet") {
                                          if (socket?.isOpen == true) socket?.send(data)
                                      } else {
                                          bluetoothOut?.write(data)
                                      }
                                  } catch (_: Exception) {}
                              }
                          }
                          rec.stop()
                          rec.release()
                          recorder = null
                      } catch (e: Exception) {
                          runOnUiThread {
                              status.text = "تعذر تشغيل الميكروفون: ${e.message}"
                          }
                          transmitting.set(false)
                      }
                  }
              }

              private fun stopTalking() {
                  transmitting.set(false)
                  try {
                      recorder?.stop()
                  } catch (_: Exception) {}
              }

              private fun playAudio(data: ByteArray) {
                  thread {
                      try {
                          if (player == null) {
                              val min = AudioTrack.getMinBufferSize(
                                  sampleRate, channelOut, audioFormat
                              )
                              player = AudioTrack(
                                  AudioAttributes.Builder()
                                      .setUsage(AudioAttributes.USAGE_VOICE_COMMUNICATION)
                                      .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
                                      .build(),
                                  AudioFormat.Builder()
                                      .setSampleRate(sampleRate)
                                      .setEncoding(audioFormat)
                                      .setChannelMask(channelOut)
                                      .build(),
                                  maxOf(min, 4096),
                                  MODE_STREAM,
                                  AudioManager.AUDIO_SESSION_ID_GENERATE
                              )
                              player?.play()
                          }
                          player?.write(data, 0, data.size)
                      } catch (_: Exception) {}
                  }
              }

              private fun setDisconnected(message: String) {
                  connected = false
                  transmitting.set(false)
                  talkButton.isEnabled = false
                  connectButton.text = "اتصال"
                  status.text = message
              }

              private fun stopConnection() {
                  connected = false
                  transmitting.set(false)
                  try { socket?.close() } catch (_: Exception) {}
                  socket = null
                  try { bluetoothOut?.close() } catch (_: Exception) {}
                  bluetoothOut = null
                  bluetoothIn = null
                  try { player?.stop(); player?.release() } catch (_: Exception) {}
                  player = null
                  setDisconnected("غير متصل")
                  connectButton.text = "اتصال"
              }

              override fun onDestroy() {
                  stopConnection()
                  super.onDestroy()
              }
          }
          EOF

          cat > server/package.json <<'EOF'
          {
            "name": "walkietalkiepro-relay",
            "version": "1.0.0",
            "private": true,
            "main": "server.js",
            "scripts": {
              "start": "node server.js"
            },
            "dependencies": {
              "ws": "^8.18.0"
            }
          }
          EOF

          cat > server/server.js <<'EOF'
          const WebSocket = require("ws");
          const url = require("url");

          const port = process.env.PORT || 8080;
          const wss = new WebSocket.Server({ port });

          const rooms = new Map();

          wss.on("connection", (ws, req) => {
            const params = url.parse(req.url, true).query;
            const room = String(params.room || "default").slice(0, 80);

            if (!rooms.has(room)) rooms.set(room, new Set());
            rooms.get(room).add(ws);

            ws.on("message", (message, isBinary) => {
              for (const peer of rooms.get(room)) {
                if (peer !== ws && peer.readyState === WebSocket.OPEN) {
                  peer.send(message, { binary: isBinary });
                }
              }
            });

            ws.on("close", () => {
              const members = rooms.get(room);
              if (members) {
                members.delete(ws);
                if (members.size === 0) rooms.delete(room);
              }
            });
          });

          console.log("WalkieTalkiePro relay listening on", port);
          EOF

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build APK
        run: gradle assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: WalkieTalkiePro-APK
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error

      - name: Upload server source
        uses: actions/upload-artifact@v4
        with:
          name: WalkieTalkiePro-Server
          path: server/
